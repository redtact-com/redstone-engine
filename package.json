{
  "name": "redstone-engine",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:engine": "node packages/engine-js/scripts/build.mjs",
    "pretest": "npm run build:engine",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "size": "node packages/engine-js/scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
